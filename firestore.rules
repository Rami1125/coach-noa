rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Strict Non-Destructive Policy for H. Saban Building Materials
    // =========================================================================
    
    // Existing core production collections: Read-Only for Observer & Coach
    match /orders/{orderId} {
      allow read: if true;
      allow write: if false;
    }

    match /clients/{clientId} {
      allow read: if true;
      allow write: if false;
    }

    match /logistics_catalog/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    match /conversations/{conversationId} {
      allow read: if true;
      allow write: if false;
      
      // Messages sub-collection
      match /messages/{messageId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /learned_knowledge/{ruleId} {
      allow read: if true;
      allow write: if false;
    }

    // Dedicated new collection for autonomous daily audits and AI coach feedback
    // Permits saving reports generated by the autonomous observer & coach
    match /noa_daily_audits/{auditId} {
      allow read, write: if true;
    }

    // Default safety catch-all for any other collections
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
